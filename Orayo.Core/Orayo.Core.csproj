<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Orayo</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../Application/*.cs" Exclude="../Application/AppServices.cs" Link="Application/%(Filename)%(Extension)" />
    <Compile Include="../Infrastructure/Storage/*.cs" Link="Infrastructure/Storage/%(Filename)%(Extension)" />
    <Compile Include="../Services/NodeLinkParser.cs;../Services/NodeLinkSerializer.cs;../Services/XrayConfigBuilder.cs;../Services/DnsPresetService.cs;../Services/RouteRulePresetService.cs;../Services/EchSettings.cs;../Services/FinalmaskJson.cs;../Services/ServerLatencyService.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../Strings/Strings.Designer.cs" Link="Strings/Strings.Designer.cs" />
    <EmbeddedResource Include="../Strings/*.resx" Link="Strings/%(Filename)%(Extension)">
      <ManifestResourceName>Orayo.Strings.%(Filename)</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
